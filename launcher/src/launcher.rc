// Version resource + manifest settings of the launcher executable.
#include <windows.h>
#include "oreo_version.h"

// Icon id 1: the lowest numbered icon resource is what Explorer and the taskbar show.
1 ICON "../assets/icon.ico"

// The window's page (ui/page.cpp puts it together) and its typeface, which the page cannot
// load from a file. Montserrat, SIL Open Font License 1.1 (see the font's own name table).
PAGE_HTML RCDATA "ui/page/page.html"
PAGE_WINDOW_CSS RCDATA "ui/page/window.css"
PAGE_CARDS_CSS RCDATA "ui/page/cards.css"
PAGE_SHEETS_CSS RCDATA "ui/page/sheets.css"
PAGE_CONTRAST_CSS RCDATA "ui/page/contrast.css"
PAGE_STAGE_JS RCDATA "ui/page/stage.js"
PAGE_CARDS_JS RCDATA "ui/page/cards.js"
PAGE_SHEETS_JS RCDATA "ui/page/sheets.js"
MONTSERRAT_BOLD RCDATA "../assets/fonts/Montserrat-Bold.otf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PROJECTOREO_VERSION_COMMA
PRODUCTVERSION PROJECTOREO_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ProjectOreo"
            VALUE "FileDescription", "Oreo Launcher"
            VALUE "FileVersion", PROJECTOREO_VERSION
            VALUE "InternalName", "OreoLauncher"
            VALUE "OriginalFilename", "OreoLauncher.exe"
            VALUE "ProductName", "Oreo Launcher"
            VALUE "ProductVersion", PROJECTOREO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
